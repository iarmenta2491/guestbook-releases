{
    "name": "my-guestbook",
    "version": "1.3.0",
    "description": "AI-powered offline digital guestbook kiosk",
    "main": "electron/main.js",
    "author": "My Guestbook",
    "license": "ISC",
    "scripts": {
        "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
        "build": "vite build",
        "start": "npm run build && electron .",
        "dist": "npm run build && electron-builder --win --x64",
        "dist:dir": "npm run build && electron-builder --win --x64 --dir",
        "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
        "dist:mac:publish": "npm run build && electron-builder --mac --x64 --arm64 --publish always",
        "postinstall": "node scripts/download-model.js"
    },
    "keywords": [],
    "dependencies": {
        "@fontsource/outfit": "^5.0.0",
        "cross-env": "^7.0.3",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.8.9",
        "ffmpeg-static": "^5.2.0",
        "fluent-ffmpeg": "^2.1.3",
        "nodejs-whisper": "^0.1.15",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-sortablejs": "^6.1.4",
        "sortablejs": "^1.15.3"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "vite": "^6.0.7",
        "wait-on": "^8.0.1"
    },
    "allowScripts": {
        "electron@33.4.11": true,
        "esbuild@0.25.12": true,
        "ffmpeg-static@5.3.0": true
    },
    "build": {
        "appId": "com.myguestbook.kiosk",
        "productName": "My Guestbook",
        "copyright": "Copyright © 2024 My Guestbook",
        "directories": {
            "output": "release",
            "buildResources": "build-resources"
        },
        "files": [
            { "from": "dist",     "to": "dist",     "filter": ["**/*"] },
            { "from": "electron", "to": "electron", "filter": ["**/*"] },
            { "from": "scripts",  "to": "scripts",  "filter": ["**/*"] },
            { "from": "pipeline", "to": "pipeline", "filter": ["**/*"] },
            { "from": "engine",   "to": "engine",   "filter": ["**/*"] },
            "node_modules/**/*",
            "package.json",
            "!node_modules/electron/**",
            "!node_modules/.cache/**",
            "!**/*.md",
            "!**/.git/**"
        ],
        "asarUnpack": [
            "node_modules/ffmpeg-static/**/*"
        ],
        "win": {
            "extraResources": [
                {
                    "from": "assets",
                    "to": "assets",
                    "filter": ["**/*"]
                }
            ],
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build-resources/icon.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "installerIcon": "build-resources/icon.ico",
            "uninstallerIcon": "build-resources/icon.ico",
            "installerHeaderIcon": "build-resources/icon.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "My Guestbook",
            "deleteAppDataOnUninstall": false
        },
        "compression": "normal",
        "nodeGypRebuild": false,
        "npmRebuild": false,
        "publish": [
            {
                "provider": "github",
                "owner": "iarmenta2491",
                "repo": "guestbook-releases",
                "releaseType": "release"
            }
        ],
        "mac": {
            "target": [
                { "target": "dmg", "arch": ["x64", "arm64"] }
            ],
            "icon": "build-resources/icon.icns",
            "category": "public.app-category.entertainment",
            "darkModeSupport": true,
            "hardenedRuntime": false,
            "gatekeeperAssess": false
        },
        "dmg": {
            "title": "${productName} ${version}",
            "icon": "build-resources/icon.icns",
            "background": null,
            "window": { "width": 540, "height": 380 },
            "contents": [
                { "x": 140, "y": 180, "type": "file" },
                { "x": 400, "y": 180, "type": "link", "path": "/Applications" }
            ]
        }
    }
}

